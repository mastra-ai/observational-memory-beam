# The Observer, Reflector, grader and embeddings go through OpenRouter.
OPENROUTER_API_KEY=

# The answering model (default anthropic/claude-opus-5-5) uses Anthropic's API directly.
# To answer through OpenRouter instead, set BEAM_ACTOR=openrouter/anthropic/claude-opus-5.5
# and leave this empty.
ANTHROPIC_API_KEY=

# Where the BEAM dataset is (default ./data/beam)
# BEAM_DATA_DIR=./data/beam
